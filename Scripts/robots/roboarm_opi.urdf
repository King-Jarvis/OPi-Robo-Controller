<?xml version="1.0"?>
<!-- RoboArm OPi, written CAD-style: every link frame is aligned with the world
     at the zero pose (arm straight up). Units are metres / radians, as URDF
     requires. Must give the same FK as the DH table in roboarm_opi.json. -->
<robot name="roboarm_opi">
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="flange"/>

  <joint name="J1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0543" upper="3.0543" effort="10" velocity="1"/>
  </joint>
  <joint name="J2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.136" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.3090" upper="1.3090" effort="10" velocity="1"/>
  </joint>
  <joint name="J3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.250" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4435" effort="10" velocity="1"/>
  </joint>
  <joint name="J4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0.026 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6180" upper="2.6180" effort="10" velocity="1"/>
  </joint>
  <joint name="J5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0 0.23525" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.3090" upper="1.3090" effort="10" velocity="1"/>
  </joint>
  <joint name="J6" type="continuous">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="flange_fixed" type="fixed">
    <parent link="link6"/><child link="flange"/>
    <origin xyz="0 0 0.0115" rpy="0 0 0"/>
  </joint>
</robot>
